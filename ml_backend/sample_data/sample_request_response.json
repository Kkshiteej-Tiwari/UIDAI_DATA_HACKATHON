  "sample_forecast_request": {
    "description": "POST /api/forecast/state/Maharashtra",
    "request": {
      "horizon_months": 6
    },
    "response": {
      "success": true,
      "state": "Maharashtra",
      "forecast": {
        "forecast": [1234567, 1256789, 1278901, 1301012, 1323123, 1345234],
        "lower_ci": [1134567, 1146789, 1158901, 1171012, 1183123, 1195234],
        "upper_ci": [1334567, 1366789, 1398901, 1431012, 1463123, 1495234],
        "dates": ["2025-02", "2025-03", "2025-04", "2025-05", "2025-06", "2025-07"],
        "confidence_level": 0.95,
        "method": "SARIMA"
      },
      "model_info": {
        "order": [1, 1, 1],
