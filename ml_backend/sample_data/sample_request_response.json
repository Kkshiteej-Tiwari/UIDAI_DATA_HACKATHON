  "sample_scenario_request": {
    "description": "POST /api/forecast/scenario-comparison",
    "request": {
      "states": ["Bihar", "Jharkhand"],
      "intervention_params": {
        "boost_percent": 15,
        "start_month": 0,
        "duration_months": 3
      },
      "horizon_months": 6
    },
    "response": {
      "success": true,
      "states": {
        "Bihar": {
          "state": "Bihar",
          "baseline": {
            "forecast": [500000, 510000, 520000, 530000, 540000, 550000]
          },
          "intervention": {
            "forecast": [575000, 586500, 598000, 530000, 540000, 550000],
            "boost_percent": 15
          },
          "difference": [75000, 76500, 78000, 0, 0, 0],
          "cumulative_impact": 229500,
          "summary": {
            "baseline_total": 3150000,
            "intervention_total": 3379500,
            "percent_increase": 7.29
          }
        }
      },
      "total_impact": 458000
    }
  },
  "curl_examples": {
    "spatial_analysis": "curl -X POST http://localhost:8000/api/hotspots/spatial-analysis -H \"Content-Type: application/json\" -d '{\"states\": [\"Maharashtra\", \"Bihar\"]}'",
    "anomalies": "curl -X POST http://localhost:8000/api/hotspots/anomalies -H \"Content-Type: application/json\" -d '{\"threshold\": 2.0, \"granularity\": \"state\"}'",
    "heatmap": "curl http://localhost:8000/api/hotspots/heatmap/Maharashtra",
    "forecast": "curl -X POST http://localhost:8000/api/forecast/state/Maharashtra -H \"Content-Type: application/json\" -d '{\"horizon_months\": 6}'",
    "scenario": "curl -X POST http://localhost:8000/api/forecast/scenario-comparison -H \"Content-Type: application/json\" -d '{\"states\": [\"Bihar\"], \"intervention_params\": {\"boost_percent\": 10, \"start_month\": 0, \"duration_months\": 3}}'"
  }
}
