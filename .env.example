# ===================================
# UIDAI Analytics Dashboard - Environment Variables Template
# Copy this file to .env and fill in your actual values
# ===================================

# Server Configuration
PORT=3000
NODE_ENV=development

# ===================================
# UIDAI Government Data APIs
# ===================================

# API Key from data.gov.in
UIDAI_API_KEY=your_uidai_api_key_here
UIDAI_BASE_URL=https://api.data.gov.in/resource

# API Endpoint Resource IDs
ENROLLMENT_DATA_RESOURCE_ID=your_enrollment_resource_id
DEMOGRAPHIC_DATA_RESOURCE_ID=your_demographic_resource_id
BIOMETRIC_DATA_RESOURCE_ID=your_biometric_resource_id

# ===================================
# GROQ AI API Keys (for ML/AI features)
# ===================================

GROQ_API_KEY_1=your_groq_api_key_1
GROQ_API_KEY_2=your_groq_api_key_2
GROQ_API_KEY_3=your_groq_api_key_3
GROQ_API_KEY_4=your_groq_api_key_4

GROQ_API_KEY=${GROQ_API_KEY_1}
GROQ_BASE_URL=https://api.groq.com/openai/v1
